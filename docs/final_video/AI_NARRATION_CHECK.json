  "output_sha256": "a7047b29c36315937f3ffd3a8d6f9649fe36391a5fb2142d01bcf49803ad60ca",
  "peak_dbfs": -1.423417413657423,
  "cues": [
    {
      "index": 1,
      "source_start": 0,
      "source_end": 6,
      "start": 0.0,
      "end": 5.48,
      "text": "Our project studies complete physical pick-and-place with a Franka Panda in MuJoCo.",
      "speech_start": 0.12,
      "speech_end": 4.969875,
      "trailing_pause_s": 0.5101250000000004,
      "audio_tempo": 1.0
    },
    {
      "index": 2,
      "source_start": 6,
      "source_end": 10,
      "start": 5.48,
      "end": 10.64,
      "text": "We investigate blocked approaches, corrupted geometry and contact retention.",
      "speech_start": 5.6,
      "speech_end": 10.161916666666666,
      "trailing_pause_s": 0.4780833333333341,
      "audio_tempo": 1.0
    },
    {
      "index": 3,
      "source_start": 10,
      "source_end": 15,
      "start": 10.64,
      "end": 15.28,
      "text": "The aim is to explain task failures and test bounded interventions.",
      "speech_start": 10.76,
      "speech_end": 14.731333333333334,
      "trailing_pause_s": 0.5486666666666657,
      "audio_tempo": 1.0
    },
    {
      "index": 4,
      "source_start": 15,
      "source_end": 24,
      "start": 15.28,
      "end": 21.72,
      "text": "The baseline loads six public YCB models and supports seeded random object selection and placement.",
      "speech_start": 15.4,
      "speech_end": 21.121041666666667,
      "trailing_pause_s": 0.5989583333333321,
      "audio_tempo": 1.0
    },
    {
      "index": 5,
      "source_start": 24,
      "source_end": 30,
      "start": 21.72,
      "end": 26.28,
      "text": "This complete run starts with a checked approach and physical finger closure.",
      "speech_start": 21.84,
      "speech_end": 25.766625,
      "trailing_pause_s": 0.5133749999999999,
      "audio_tempo": 1.0
    },
    {
      "index": 6,
      "source_start": 30,
      "source_end": 35,
      "start": 26.28,
      "end": 31.12,
      "text": "Contact lifts and holds the target before the robot begins its transfer.",
      "speech_start": 26.4,
      "speech_end": 30.643,
      "trailing_pause_s": 0.4770000000000003,
      "audio_tempo": 1.0
    },
    {
      "index": 7,
      "source_start": 35,
      "source_end": 41,
      "start": 31.12,
      "end": 36.28,
      "text": "The arm carries the object to the destination, lowers it and opens the fingers.",
      "speech_start": 31.24,
      "speech_end": 35.73766666666667,
      "trailing_pause_s": 0.5423333333333318,
      "audio_tempo": 1.0
    },
    {
      "index": 8,
      "source_start": 41,
      "source_end": 45,
      "start": 36.28,
      "end": 41.28,
      "text": "Release and table support are checked; failures remain in the evaluation.",
      "speech_start": 36.4,
      "speech_end": 40.776666666666664,
      "trailing_pause_s": 0.5033333333333374,
      "audio_tempo": 1.0
    },
    {
      "index": 9,
      "source_start": 45,
      "source_end": 55,
      "start": 41.28,
      "end": 49.2,
      "text": "Mesh-based candidates are proposals. Inverse kinematics and collision checks decide which can execute.",
      "speech_start": 41.4,
      "speech_end": 48.62654166666667,
      "trailing_pause_s": 0.5734583333333347,
      "audio_tempo": 1.0
    },
    {
      "index": 10,
      "source_start": 55,
      "source_end": 62,
      "start": 49.2,
      "end": 56.04,
      "text": "Complete success requires an eighty-millimeter lift, a one-second hold and sustained bilateral contact.",
      "speech_start": 49.32,
      "speech_end": 55.52108333333333,
      "trailing_pause_s": 0.5189166666666694,
      "audio_tempo": 1.0
    },
    {
      "index": 11,
      "source_start": 62,
      "source_end": 66,
      "start": 56.04,
      "end": 61.16,
      "text": "Release must be stable, within fifty-five millimeters of the destination.",
      "speech_start": 56.16,
      "speech_end": 60.656083333333335,
      "trailing_pause_s": 0.5039166666666617,
      "audio_tempo": 1.0
    },
    {
      "index": 12,
      "source_start": 66,
      "source_end": 70,
      "start": 61.16,
      "end": 65.84,
      "text": "Planning still uses simulator geometry; sensing is synthetic.",
      "speech_start": 61.28,
      "speech_end": 65.34725,
      "trailing_pause_s": 0.4927500000000009,
      "audio_tempo": 1.0
    },
    {
      "index": 13,
      "source_start": 70,
      "source_end": 75,
      "start": 65.84,
      "end": 70.72,
      "text": "The original candidates are rejected because a nearby can blocks the palm.",
      "speech_start": 65.96,
      "speech_end": 70.24983333333333,
      "trailing_pause_s": 0.47016666666667106,
      "audio_tempo": 1.0
    },
    {
      "index": 14,
      "source_start": 75,
      "source_end": 84,
      "start": 70.72,
      "end": 77.16,
      "text": "We keep the scene and safety checks, adding bounded inclined and offset grasp alternatives.",
      "speech_start": 70.84,
      "speech_end": 75.95058333333333,
      "trailing_pause_s": 1.2094166666666695,
      "audio_tempo": 1.0
    },
    {
      "index": 15,
      "source_start": 84,
      "source_end": 93,
      "start": 77.16,
      "end": 83.6,
      "text": "The chosen alternative lifts the target and carries it through the checked corridor.",
      "speech_start": 77.28,
      "speech_end": 81.540375,
      "trailing_pause_s": 2.059624999999997,
      "audio_tempo": 1.0
    },
    {
      "index": 16,
      "source_start": 93,
      "source_end": 100,
      "start": 83.6,
      "end": 91.24,
      "text": "The robot lowers and releases it. This development demonstration is separate from the paired evaluation.",
      "speech_start": 83.72,
      "speech_end": 90.723375,
      "trailing_pause_s": 0.5166249999999906,
      "audio_tempo": 1.0
    },
    {
      "index": 17,
      "source_start": 100,
      "source_end": 106,
      "start": 91.24,
      "end": 97.4,
      "text": "This elastic model genuinely deforms; the YCB foam brick in the baseline remains rigid.",
      "speech_start": 91.36,
      "speech_end": 96.87258333333334,
      "trailing_pause_s": 0.5274166666666673,
      "audio_tempo": 1.0
    },
    {
      "index": 18,
      "source_start": 106,
      "source_end": 114,
      "start": 97.4,
      "end": 103.4,
      "text": "The controller regulates the weaker finger contact to retain the object during lift and transfer.",
      "speech_start": 97.52,
      "speech_end": 102.86254166666667,
      "trailing_pause_s": 0.5374583333333334,
      "audio_tempo": 1.0
    },
    {
      "index": 19,
      "source_start": 114,
      "source_end": 121,
      "start": 103.4,
      "end": 109.6,
      "text": "Fixed preload completes two of six soft-object tasks; regulation completes six of six.",
      "speech_start": 103.52,
      "speech_end": 109.05258333333333,
      "trailing_pause_s": 0.5474166666666633,
      "audio_tempo": 1.0
    },
    {
      "index": 20,
      "source_start": 121,
      "source_end": 127,
      "start": 109.6,
      "end": 115.24,
      "text": "These force and strain curves illustrate one development run, rather than a group average.",
      "speech_start": 109.72,
      "speech_end": 114.69245833333333,
      "trailing_pause_s": 0.5475416666666604,
      "audio_tempo": 1.0
    },
    {
      "index": 21,
      "source_start": 127,
      "source_end": 131,
      "start": 115.24,
      "end": 121.48,
      "text": "Across formal trials, mean peak strain rises from about three-point-seven to four-point-nine percent.",
      "speech_start": 115.36,
      "speech_end": 120.9825,
      "trailing_pause_s": 0.4975000000000023,
      "audio_tempo": 1.0
    },
    {
      "index": 22,
      "source_start": 131,
      "source_end": 135,
      "start": 121.48,
      "end": 127.4,
      "text": "Retention improves within the tested limits; reduced deformation is not demonstrated.",
      "speech_start": 121.6,
      "speech_end": 126.89733333333334,
      "trailing_pause_s": 0.5026666666666699,
      "audio_tempo": 1.0
    },
    {
      "index": 23,
      "source_start": 135,
      "source_end": 140,
      "start": 127.4,
      "end": 132.96,
      "text": "A separate rigid-load study randomizes mass, friction and actuator delay.",
      "speech_start": 127.52,
      "speech_end": 132.44645833333334,
      "trailing_pause_s": 0.5135416666666686,
      "audio_tempo": 1.0
    },
    {
      "index": 24,
      "source_start": 140,
      "source_end": 145,
      "start": 132.96,
      "end": 137.68,
      "text": "Regulation changes completion from ten of twelve to twelve of twelve.",
      "speech_start": 133.08,
      "speech_end": 137.14966666666666,
      "trailing_pause_s": 0.5303333333333455,
      "audio_tempo": 1.0
    },
    {
      "index": 25,
      "source_start": 145,
      "source_end": 150,
      "start": 137.68,
      "end": 144.04,
      "text": "Synthetic depth includes missing stripes, drift, outliers and a persistent calibration bias.",
      "speech_start": 137.8,
      "speech_end": 143.524125,
      "trailing_pause_s": 0.5158749999999941,
      "audio_tempo": 1.0
    },
    {
      "index": 26,
      "source_start": 150,
      "source_end": 155,
      "start": 144.04,
      "end": 149.76,
      "text": "The single-packet method completes six of twelve tasks; naive fusion completes only one.",
      "speech_start": 144.16,
      "speech_end": 149.28370833333332,
      "trailing_pause_s": 0.47629166666666833,
      "audio_tempo": 1.0
    },
    {
      "index": 27,
      "source_start": 155,
      "source_end": 160,
      "start": 149.76,
      "end": 156.2,
      "text": "Cross-packet voxel support rejects transient outliers and reaches nine successes in twelve trials.",
      "speech_start": 149.88,
      "speech_end": 155.72883333333334,
      "trailing_pause_s": 0.4711666666666474,
      "audio_tempo": 1.0
    },
    {
      "index": 28,
      "source_start": 160,
      "source_end": 169,
      "start": 156.2,
      "end": 164.32,
      "text": "This successful development example uses the robust observer, without target CAD or instance labels in grasp estimation.",
      "speech_start": 156.32,
      "speech_end": 163.741125,
      "trailing_pause_s": 0.5788749999999823,
      "audio_tempo": 1.0
    },
    {
      "index": 29,
      "source_start": 169,
      "source_end": 176,
      "start": 164.32,
      "end": 171.16,
      "text": "Planning still uses simulator geometry; measured observations do not make the entire system vision-only.",
      "speech_start": 164.44,
      "speech_end": 170.626625,
      "trailing_pause_s": 0.5333750000000066,
      "audio_tempo": 1.0
    },
    {
      "index": 30,
      "source_start": 176,
      "source_end": 181,
      "start": 171.16,
      "end": 175.52,
      "text": "The robot carries and releases the object in this illustration.",
      "speech_start": 171.28,
      "speech_end": 175.00016666666667,
      "trailing_pause_s": 0.519833333333338,
      "audio_tempo": 1.0
    },
    {
      "index": 31,
      "source_start": 181,
      "source_end": 185,
      "start": 175.52,
      "end": 179.76,
      "text": "The formal failures remain wedge slips, in separate trials.",
      "speech_start": 175.64,
      "speech_end": 179.273,
      "trailing_pause_s": 0.48699999999999477,
      "audio_tempo": 1.0
    },
    {
      "index": 32,
      "source_start": 185,
      "source_end": 190,
      "start": 179.76,
      "end": 184.56,
      "text": "A transient command fault leaves the first closure wider than the target.",
      "speech_start": 179.88,
      "speech_end": 184.01316666666668,
      "trailing_pause_s": 0.5468333333333248,
      "audio_tempo": 1.0
    },
    {
      "index": 33,
      "source_start": 190,
      "source_end": 193.5,
      "start": 184.56,
      "end": 189.08,
      "text": "No bilateral contact is detected; the grasp is rejected.",
      "speech_start": 184.68,
      "speech_end": 188.59641666666667,
      "trailing_pause_s": 0.4835833333333426,
      "audio_tempo": 1.0
    },
    {
      "index": 34,
      "source_start": 193.5,
      "source_end": 196,
      "start": 189.08,
      "end": 192.64,
      "text": "The robot opens and withdraws safely.",
      "speech_start": 189.2,
      "speech_end": 191.61116666666666,
      "trailing_pause_s": 1.0288333333333242,
      "audio_tempo": 1.0
    },
    {
      "index": 35,
      "source_start": 196,
      "source_end": 201,
      "start": 192.64,
      "end": 197.08,
      "text": "It reobserves and makes a second grasp in the same evolving scene.",
      "speech_start": 192.76,
      "speech_end": 196.59195833333334,
      "trailing_pause_s": 0.4880416666666747,
      "audio_tempo": 1.0
    },
    {
      "index": 36,
      "source_start": 201,
      "source_end": 209,
      "start": 197.08,
      "end": 202.76,
      "text": "The second grasp holds through lift and transfer; the scene was never reset.",
      "speech_start": 197.2,
      "speech_end": 201.51241666666667,
      "trailing_pause_s": 1.2475833333333242,
      "audio_tempo": 1.0
    },
    {
      "index": 37,
      "source_start": 209,
      "source_end": 216,
      "start": 202.76,
      "end": 207.96,
      "text": "After lowering and release, table support and final placement are verified.",
      "speech_start": 202.88,
      "speech_end": 207.41516666666666,
      "trailing_pause_s": 0.5448333333333437,
      "audio_tempo": 1.0
    },
    {
      "index": 38,
      "source_start": 216,
      "source_end": 220,
      "start": 207.96,
      "end": 213.08,
      "text": "All six controlled episodes recover; broader recovery remains unproven.",
      "speech_start": 208.08,
      "speech_end": 212.57858333333334,
      "trailing_pause_s": 0.5014166666666711,
      "audio_tempo": 1.0
    },
    {
      "index": 39,
      "source_start": 220,
      "source_end": 225,
      "start": 213.08,
      "end": 217.84,
      "text": "A passive hinge remains dynamic while the whole assembly is transported.",
      "speech_start": 213.2,
      "speech_end": 217.33516666666668,
      "trailing_pause_s": 0.5048333333333233,
      "audio_tempo": 1.0
    },
    {
      "index": 40,
      "source_start": 225,
      "source_end": 230,
      "start": 217.84,
      "end": 223.36,
      "text": "All six assembly tasks succeed; deliberate lid opening is not demonstrated.",
      "speech_start": 217.96,
      "speech_end": 222.84458333333333,
      "trailing_pause_s": 0.5154166666666811,
      "audio_tempo": 1.0
    },
    {
      "index": 41,
      "source_start": 230,
      "source_end": 234,
      "start": 223.36,
      "end": 228.88,
      "text": "Measured points propose grasps for procedural instances without target CAD.",
      "speech_start": 223.48,
      "speech_end": 228.37970833333333,
      "trailing_pause_s": 0.5002916666666692,
      "audio_tempo": 1.0
    },
    {
      "index": 42,
      "source_start": 234,
      "source_end": 238,
      "start": 228.88,
      "end": 233.16,
      "text": "Both methods tie at eleven of twelve, with one shared slip.",
      "speech_start": 229.0,
      "speech_end": 232.662125,
      "trailing_pause_s": 0.4978749999999934,
      "audio_tempo": 1.0
    },
    {
      "index": 43,
      "source_start": 238,
      "source_end": 245,
      "start": 233.16,
      "end": 240.04,
      "text": "In separate stronger-clutter trials, active sensing changes completion from five of six to three of six.",
      "speech_start": 233.28,
      "speech_end": 239.49470833333334,
      "trailing_pause_s": 0.5452916666666567,
      "audio_tempo": 1.0
    },
    {
      "index": 44,
      "source_start": 245,
      "source_end": 250,
      "start": 240.04,
      "end": 244.72,
      "text": "The candidate study contains one hundred eighty paired physical episodes.",
      "speech_start": 240.16,
      "speech_end": 244.24920833333334,
      "trailing_pause_s": 0.4707916666666563,
      "audio_tempo": 1.0
    },
    {
      "index": 45,
      "source_start": 250,
      "source_end": 256,
      "start": 244.72,
      "end": 250.96,
      "text": "With three neighbors, local alternatives change success from fifty-four to fifty-eight out of sixty.",
      "speech_start": 244.84,
      "speech_end": 250.42020833333333,
      "trailing_pause_s": 0.5397916666666731,
      "audio_tempo": 1.0
    },
    {
      "index": 46,
      "source_start": 256,
      "source_end": 263,
      "start": 250.96,
      "end": 256.16,
      "text": "With five neighbors, success changes from twenty-six to twenty-nine out of thirty.",
      "speech_start": 251.08,
      "speech_end": 255.61733333333333,
      "trailing_pause_s": 0.5426666666666904,
      "audio_tempo": 1.0
    },
    {
      "index": 47,
      "source_start": 263,
      "source_end": 268,
      "start": 256.16,
      "end": 262.68,
      "text": "The separate exploratory screening contains one hundred twenty-six episodes across fourteen conditions.",
      "speech_start": 256.28,
      "speech_end": 262.1700833333333,
      "trailing_pause_s": 0.5099166666666974,
      "audio_tempo": 1.0
    },
    {
      "index": 48,
      "source_start": 268,
      "source_end": 273,
      "start": 262.68,
      "end": 269.52,
      "text": "The intervals show substantial uncertainty; none of the comparisons passes its stated statistical threshold.",
      "speech_start": 262.8,
      "speech_end": 269.0133333333333,
      "trailing_pause_s": 0.5066666666666606,
      "audio_tempo": 1.0
    },
    {
      "index": 49,
      "source_start": 273,
      "source_end": 277,
      "start": 269.52,
      "end": 274.0,
      "text": "Initial scenes and physics are paired, with all failures retained.",
      "speech_start": 269.64,
      "speech_end": 273.4964166666667,
      "trailing_pause_s": 0.5035833333333244,
      "audio_tempo": 1.0
    },
    {
      "index": 50,
      "source_start": 277,
      "source_end": 280,
      "start": 274.0,
      "end": 279.2,
      "text": "Development demonstrations are excluded from both evaluation denominators.",
      "speech_start": 274.12,
      "speech_end": 278.727875,
      "trailing_pause_s": 0.47212500000000546,
      "audio_tempo": 1.0
    },
    {
      "index": 51,
      "source_start": 280,
      "source_end": 286,
      "start": 279.2,
      "end": 284.76,
      "text": "The main finding is to diagnose geometry, sensing and contact retention together.",
      "speech_start": 279.32,
      "speech_end": 284.2277916666667,
      "trailing_pause_s": 0.5322083333333012,
      "audio_tempo": 1.0
    },
    {
      "index": 52,
      "source_start": 286,
      "source_end": 292,
      "start": 284.76,
      "end": 290.52,
      "text": "Source code, frozen records and the ten-page report provide reproduction instructions.",
      "speech_start": 284.88,
      "speech_end": 289.99220833333334,
      "trailing_pause_s": 0.5277916666666442,
      "audio_tempo": 1.0
    },
    {
      "index": 53,
      "source_start": 292,
      "source_end": 296,
      "start": 290.52,
      "end": 294.12,
      "text": "Forty-nine tests and both evidence audits pass.",
      "speech_start": 290.64,
      "speech_end": 293.64570833333335,
      "trailing_pause_s": 0.4742916666666588,
      "audio_tempo": 1.0
    },
    {
      "index": 54,
      "source_start": 296,
      "source_end": 300,
      "start": 294.12,
      "end": 300.0,
      "text": "Next steps target wedge stability, deformation-aware control and less ideal sensing.",
      "speech_start": 294.24,
      "speech_end": 299.514125,
      "trailing_pause_s": 0.4858750000000214,
      "audio_tempo": 1.0
    }
  ]
}